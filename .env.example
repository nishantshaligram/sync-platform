# ============================
# QuickBooks Online (QBO) OAuth
# ============================
QBO_CLIENT_ID=your_qbo_client_id_here
QBO_CLIENT_SECRET=your_qbo_client_secret_here
QBO_REDIRECT_URI=http://localhost:8080/qbo/oauth/callback

# ============================
# Shopify OAuth
